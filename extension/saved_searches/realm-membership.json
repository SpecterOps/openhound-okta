  "description": "Lists all Okta realms and the users assigned to them.",
  "query": "MATCH path = (:Okta_Organization)-[:Okta_Contains]->(:Okta_Realm)-[:Okta_RealmContains]->(:Okta_User)\nRETURN path\nLIMIT 1000",
