{
  "description": "Source-shaped Okta SAML assignment cases for source-exact, email-shaped source.login normalization.",
  "cases": [
    {
      "name": "exact_profile_login_email_equality",
      "source_profile": {
        "login": "alice.saml@example.test",
        "email": "alice.saml@example.test"
      },
      "claim_mappings": [
        {
          "id": "okta:saml:claim-mapping:0oa_saml:0",
          "app_id": "0oa_saml",
          "claim_name": "NameID",
          "mapping_type": "name_id",
          "mapping_origin": "application_user_name",
          "claim_type": "name_id",
          "source_property": "source.login",
          "expression": "${source.login}",
          "format": "urn:oasis:names:tc:SAML:1.0:nameid-format:unspecified"
        }
      ],
      "expected": {
        "match_values": ["alice.saml@example.test"],
        "email_match_values": ["alice.saml@example.test"],
        "scoped_exact_match_values": ["alice.saml@example.test"],
        "incomplete_match_value_fields": [],
        "source_properties": ["source.login"]
      }
    },
    {
      "name": "trimmed_casefolded_profile_equality",
      "source_profile": {
        "login": "  Alice.SAML@Example.TEST  ",
        "email": "alice.saml@example.test"
      },
      "claim_mappings": [
        {
          "id": "okta:saml:claim-mapping:0oa_saml:0",
          "app_id": "0oa_saml",
          "claim_name": "NameID",
          "mapping_type": "name_id",
          "mapping_origin": "application_user_name",
          "claim_type": "name_id",
          "source_property": "source.login",
          "expression": "source.login",
          "format": "urn:oasis:names:tc:SAML:1.0:nameid-format:unspecified"
        }
      ],
      "expected": {
        "match_values": ["  Alice.SAML@Example.TEST  "],
        "email_match_values": ["alice.saml@example.test"],
        "scoped_exact_match_values": ["Alice.SAML@Example.TEST"],
        "incomplete_match_value_fields": [],
        "source_properties": ["source.login"]
      }
    },
    {
      "name": "email_looking_login_mismatches_profile_email",
      "source_profile": {
