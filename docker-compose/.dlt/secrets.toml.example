[destination.bloodhoundenterprise]
# Credentials for the Okta OpenHound collector client in BHE.
token_id = "REPLACE_WITH_BHE_COLLECTOR_TOKEN_ID"
token_key = "REPLACE_WITH_BHE_COLLECTOR_TOKEN_KEY"

[sources.source.okta.credentials]
base_url = "https://REPLACE_WITH_OKTA_ORG.okta.com"
# Private key (JWT) authentication of an OAuth service app. The key is a
# private RSA JWK JSON object with a kid; PEM files are not supported.
client_id = "REPLACE_WITH_OKTA_APP_CLIENT_ID"
private_key_path = "/app/.dlt/okta-app.jwk"
# Instead of mounting the key file, supply it base64-encoded:
# private_key_b64 = "REPLACE_WITH_BASE64_ENCODED_JWK"
# Client secret authentication of an API Service Integration, instead of a key:
# client_secret = "REPLACE_WITH_CLIENT_SECRET"
# SSWS API token authentication, instead of client_id and a key or secret:
# token = "REPLACE_WITH_API_TOKEN"
